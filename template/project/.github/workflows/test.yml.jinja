name: tests

on:
  push:
    branches: [main, master]
  pull_request:
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["{{ python_requires }}"]

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
          cache: pip
{%- if gui %}

      # Qt's *offscreen* platform plugin needs no X server, so no Xvfb and none
      # of the libxcb-* family -- but libQt6Gui still links EGL, and fontconfig
      # and GLib have to be present for the plugin to load at all.
      #
      # libglib2.0-0 was renamed libglib2.0-0t64 in Ubuntu 24.04; the old name
      # fails this step. If the plugin still refuses to load, QT_DEBUG_PLUGINS=1
      # names the missing .so directly.
      - name: Qt runtime libraries
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libegl1 libglib2.0-0t64 libdbus-1-3 libfontconfig1 \
            libfreetype6 libxkbcommon0
{%- endif %}

      # Every extra by name, not a subset that happens to pull the rest in. An
      # extra that resolves only via another extra is a latent break that
      # surfaces first for a user rather than for CI.
      - name: Install
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e ".[dev{% if gui %},gui{% endif %}]"

      - name: Lint with ruff
        run: ruff check .
{%- if gui %}

      # The Qt tests guard themselves with importorskip, which would hide a
      # broken toolkit install as a quietly shrinking suite. This makes it loud,
      # and it fails next to the apt step that would be at fault rather than as
      # a mystery in the test job.
      #
      # Constructing a QApplication, not merely importing: the import succeeds
      # long before the platform plugin is asked to load, which is where a
      # missing system library actually bites.
      - name: Confirm the GUI toolkit installed
        env:
          QT_QPA_PLATFORM: offscreen
        run: |
          python -W error -c "
          import matplotlib, PySide6
          from PySide6.QtWidgets import QApplication
          QApplication([])
          print('PySide6', PySide6.__version__, '| matplotlib', matplotlib.__version__)
          "
{%- endif %}

      - name: Run tests
        run: python -m pytest -v --durations=10
{%- if research_data %}

      # CI has none of the research data, so this run also exercises the skip
      # path every contributor without it will hit. If those tests ever error
      # instead of skipping, that is a real bug -- and a green tick on a suite
      # that skipped everything is not verified science.
      - name: Confirm data-dependent tests skipped rather than failed
        run: |
          python -m pytest -q -rs 2>&1 | tee result.txt
          grep -qE '[0-9]+ skipped' result.txt \
            || echo "::warning::expected the {{ data_env_var }} tests to skip"
{%- endif %}

      # A suite that quietly shrinks goes green while testing almost nothing.
      - name: Confirm the suite did not quietly shrink
        run: |
          python -m pytest -q 2>&1 | tee count.txt
          python - <<'PY'
          import re, sys
          text = open("count.txt").read()
          match = re.search(r"(\d+) passed", text)
          passed = int(match.group(1)) if match else 0
          print(f"{passed} passed")
          if passed < {{ min_tests }}:
              sys.exit(f"only {passed} tests passed; expected at least {{ min_tests }}")
          PY
