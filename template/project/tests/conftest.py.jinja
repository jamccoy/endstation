import pytest

from endstation.testing.plugin import skip_without_data

#: Where the research data lives when {{ data_env_var }} is not set.
DEFAULT_DATA_DIR = "~/Documents/{{ project_slug }}_data"


@pytest.fixture(scope="session")
def data_dir():
    """The research data, or a skip naming the variable that enables it.

    The data is deliberately outside the checkout: it is large, and committing
    it is hard to undo. A clean clone therefore has none, which is the normal
    state for CI and for anyone who did not collect it -- not a failure.
    """
    return skip_without_data("{{ data_env_var }}", DEFAULT_DATA_DIR)
