.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.DS_Store

# Local working notes and assistant scratch files. These stay on disk and are
# never published; listed as a category so a new one does not get committed by
# accident.
CLAUDE.md
AGENTS.md
NOTES.local.md
*.local.md

# Built bundles are artifacts: the generator is what is versioned, and the
# stub hard-codes an absolute path to one machine's virtualenv.
*.app/
*.icns

# Coverage data, regenerated by every run.
.coverage
.coverage.*
htmlcov/
